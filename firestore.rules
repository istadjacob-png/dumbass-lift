rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // One doc per signed-in user (Firebase Auth): settings, splits, today.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && request.resource.data.profile is string
                            && request.resource.data.profile.size() < 500000;

      // One doc per workout, so devices never overwrite each other's sessions.
      match /sessions/{sid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.json is string
                              && request.resource.data.json.size() < 200000
                              && request.resource.data.deleted is bool;
      }
    }

    // Pre-Auth accounts (keyed by email hash). Read-only, and only by exact id,
    // so an existing user can move their data to a real login once. No writes:
    // nobody can change or wipe these any more. Close entirely once migrated.
    match /accounts/{id} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

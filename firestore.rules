rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DUMBASS accounts: one doc per user, keyed by SHA-256 of the email.
    // There is no Firebase Auth (it needs a billing step), so authorization is
    // limited to what rules can enforce without a verified identity:
    //   - reads stay open (login must fetch its own doc by id to check the
    //     password), but enumeration is blocked and ids are hashes, so a read
    //     requires already knowing the exact email — it is targeted-only.
    //   - the password hash, salt and email are IMMUTABLE after creation, so
    //     no one can take over an account or wipe its auth fields.
    //   - each app stores its own state field (lift / fuel / stretch, plus the
    //     legacy `state` field LIFT shipped with). Each must be a sane-sized
    //     string, capping data-destruction and cost-abuse via giant writes.
    match /accounts/{id} {
      function sizeOk(v) { return v is string && v.size() < 800000; }
      // Every per-app state field present must be a sane string. Absent = fine.
      function statesOk(d) {
        return (!('state'   in d) || sizeOk(d.state))
            && (!('lift'    in d) || sizeOk(d.lift))
            && (!('fuel'    in d) || sizeOk(d.fuel))
            && (!('stretch' in d) || sizeOk(d.stretch));
      }
      // At least one app must be syncing something (blocks empty/junk docs).
      function hasAnyState(d) {
        return d.keys().hasAny(['state', 'lift', 'fuel', 'stretch']);
      }

      allow get: if true;
      allow list: if false;
      allow delete: if false;

      allow create: if request.resource.data.email is string
                    && request.resource.data.salt is string
                    && request.resource.data.pwHash is string
                    && hasAnyState(request.resource.data)
                    && statesOk(request.resource.data);

      allow update: if request.resource.data.pwHash == resource.data.pwHash
                    && request.resource.data.salt == resource.data.salt
                    && request.resource.data.email == resource.data.email
                    && statesOk(request.resource.data);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
